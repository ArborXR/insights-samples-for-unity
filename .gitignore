# Unity (https://github.com/github/gitignore/blob/main/Unity.gitignore)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
# CMake intermediates from Android builds (GameActivity's native code)
/.utmp/
/[Aa]ssets/Plugins/Editor/JetBrains*

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDEs and generated project files
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Build outputs
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Written into Resources by Unity's performance testing package during builds
/[Aa]ssets/Resources/PerformanceTestRun*

# OS / local
.DS_Store
.env
.claude/

# Blender autosaves
*.blend1

__pycache__/
