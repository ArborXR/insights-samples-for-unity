  m_Script: {fileID: 11500000, guid: 7ed8d592803d6492b8f1f0ac1555a1ea, type: 3}
  m_Name: ExitPoll
  m_EditorClassIdentifier: InsightsSamples.Common::InsightsSamples.Common.SampleInfo
  id: 17-exit-poll
  number: 17
  title: Exit poll
  series: Feedback
  icon: thumbs-up
  scenario: Confidence rating after extinguisher practice
  realWorld: "At the end of fire-extinguisher practice on a training pan, learners answer a short feedback poll. Training managers use the confidence ratings to spot who needs a refresher, and the topic votes to plan the next course."
  teaches: PollUser
  sceneName: ExitPoll
  appWidePrefab: {fileID: 0}
  whatThisShows: 'PollUser asks for feedback with the SDK''s poll UI: a 1-5 rating,
    a thumbs up or down, and multiple choice. The World-Space UI sample's poll UI
    records each answer as a poll event.'
  tryThis:
  - Click Finish training and answer the three polls.
  - 'Rate your confidence 3 or lower: the tablet flags you for a refresher.'
  watchFor:
  - A poll event per answer, made by the SDK's poll UI, with the prompt and the answer.
  - PollUser makes no record of its own.
  lessonScript: ExitPollSample.cs
  lessonScriptLine: 24
  dashboardNotes:
  - methodPrefix: Event
    nameSuffix: poll
    note: Poll answers, by prompt and answer
  expectedOnPass:
  - method: Event
    name: poll
    count: 3
    atLeast: 0
    status: 
  - method: Event
    name: poll
    count: 1
    atLeast: 0
    status: answer=4
  expectedOnFail:
  - method: Event
    name: poll
    count: 3
    atLeast: 0
    status: 
  - method: Event
    name: poll
    count: 1
    atLeast: 0
    status: answer=2
