MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ed8d592803d6492b8f1f0ac1555a1ea, type: 3}
  m_Name: DiagnosticLogs
  m_EditorClassIdentifier: InsightsSamples.Common::InsightsSamples.Common.SampleInfo
  id: 12-diagnostic-logs
  number: 12
  title: Diagnostic logs
  series: Context & identity
  icon: scroll-text
  scenario: Robot cell loading its job file
  realWorld: "A pick-and-place robot cell loads a job file before it runs. When a file is missing a setting or won't load, the developers supporting the app need to know which file and why, without asking the learner."
  teaches: LogInfo, LogWarn, LogError
  sceneName: DiagnosticLogs
  appWidePrefab: {fileID: 0}
  whatThisShows: 'Logs are developer diagnostics: Info for milestones, Warn when
    the app carries on with a fallback, Error when something fails. Learner mistakes
    and performance are events, never logs.'
  tryThis:
  - 'Load job_a.json: it''s complete, so the robot runs and only an info is logged.'
  - 'Load job_b.json: it''s valid but leaves out an optional field, so a warning
    comes before the info and the robot runs at the default speed.'
  - 'Load job_c.json: it''s malformed, so loading fails with the parser''s error
    and the robot stays stopped.'
  watchFor:
  - LogWarn, then LogInfo, for job_b.json (Logs filter).
  - LogError with the file name and error for job_c.json.
  lessonScript: DiagnosticLogsSample.cs
  lessonScriptLine: 27
  dashboardNotes:
  - methodPrefix: Log
    note: 'Logs: developer diagnostics, by level and message'
  expectedOnPass:
  - method: LogWarn
    name: 
    count: 1
    status: 
  - method: LogInfo
    name: 
    count: 1
    status: 
  - method: LogError
    name: 
    count: 0
    status: 
  expectedOnFail:
  - method: LogError
    name: 
    count: 1
    status: 
  - method: LogInfo
    name: 
    count: 0
    status: 
